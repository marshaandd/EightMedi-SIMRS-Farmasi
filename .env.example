# Salin file ini menjadi .env lalu sesuaikan nilainya.
# File .env tidak boleh di-commit ke GitHub.
APP_ENV=local
APP_BASE_URL=/simrs-farmasi

DB_HOST=127.0.0.1
DB_NAME=simrs_farmasi
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Timeout idle sesi dalam detik (600–7200; default 1800 = 30 menit)
SESSION_IDLE_TIMEOUT=1800
